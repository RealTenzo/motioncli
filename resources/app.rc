#include "resource.h"
#include <windows.h>

IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,3,1,0
PRODUCTVERSION  1,3,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "tenzo"
            VALUE "FileDescription",  "Motion CLI - Native Live Wallpaper Engine"
            VALUE "FileVersion",      "1.3.1.0"
            VALUE "InternalName",     "motioncli"
            VALUE "LegalCopyright",   "Copyright (C) 2026 tenzo"
            VALUE "OriginalFilename", "motioncli.exe"
            VALUE "ProductName",      "Motion CLI"
            VALUE "ProductVersion",   "1.3.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
